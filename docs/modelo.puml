@startuml
' Modelo de domínio do sistema: Entrega 1.
'
' Este arquivo é o ponto de partida. Substitua pelo modelo da sua equipe.
' O diagrama precisa corresponder ao código entregue.
'
' Para gerar a imagem: instale o plugin PlantUML no IntelliJ, ou use
'   plantuml docs/modelo.puml
' e versione a imagem gerada ao lado deste arquivo.

hide empty members
skinparam classAttributeIconSize 0
skinparam defaultTextAlignment center

' --- ENUMS ---
enum StatusExemplar {
    DISPONIVEL
    EMPRESTADO
    DANIFICADO
    EXTRAVIADO
}

' --- INTERFACES ---
interface EmprestimoService {
    + emprestar(tombo: String, matricula: String, data: LocalDate): String
    + devolver(tombo: String, data: LocalDate): void
    + listarEmprestimosDoUsuario(matricula: String): List<EmprestimoView>
    + listarAtrasados(data: LocalDate): List<EmprestimoView>
    + reservar(codigoDoItem: String, matricula: String, data: LocalDate): String
    + listarReservas(codigoDoItem: String): List<ReservaView>
    + cancelarReserva(idDaReserva: String): void
}

interface AcervoService {
    + cadastrarItem(...)
    + buscarItem(...)
}

interface UsuarioService {
    + cadastrarUsuario(...)
}

' --- CLASSES DE DOMÍNIO E SERVIÇOS ---

class Cineclube {
    + acervo(): AcervoService
    + usuarios(): UsuarioService
    + emprestimos(): EmprestimoService
    + relatorios(): RelatorioService
    + salvar(): void
    + carregar(): void
}

class Item {
    - codigo: String
    - titulo: String
    - autoria: String
    - categoria: String
    - ano: int
    + Item(codigo: String, titulo: String, autoria: String, categoria: String, ano: int)
    + getCodigo(): String
    + getTitulo(): String
    + getAutoria(): String
    + getCategoria(): String
    + getAno(): int
    + getExemplares(): List<Exemplar>
}

class Exemplar {
    - tombo: String
    - codigoDoItem: String
    - status: StatusExemplar
    + Exemplar(tombo: String, status: StatusExemplar, codigoDoItem: String)
    + getCodigoDoItem(): String
    + getTombo(): String
    + getStatus(): StatusExemplar
    + setStatus(status: StatusExemplar): void
}

class AcervoFilme {
    - itens: List<Item>
    - exemplares: List<Exemplar>
    + cadastrarItem(codigo: String, titulo: String, autoria: String, categoria: String, ano: int): void
    + buscarItem(codigo: String): ItemView
    + listarItens(): List<ItemView>
    + buscarPorTitulo(trecho: String): List<ItemView>
    + buscarPorCategoria(categoria: String): List<ItemView>
    + adicionarExemplar(codigoDoItem: String, tombo: String): void
    + listarExemplares(codigoDoItem: String): List<ExemplarView>
    + baixarExemplar(tombo: String): void
    ~ itens(): List<Item>
    - localizar(codigo: String): Item
    - paraView(item: Item): ItemView
    {static} - exigirTextoPreenchido(valor: String, campo: String): void
}

class Usuario {
    + cadastrarUsuario(matricula: String, nome: String): void
    + buscarUsuario(matricula: String): UsuarioView
    + listarUsuarios(): List<UsuarioView>
    + desativarUsuario(matricula: String): void
    + reativarUsuario(matricula: String): void
}

class Emprestimo {
    - emprestimos: List<RegistroEmprestimo>
    - reservas: List<RegistroReserva>
    + Emprestimo()
    + emprestar(tombo: String, matricula: String, data: LocalDate): String
    + devolver(tombo: String, data: LocalDate): void
    + listarEmprestimosDoUsuario(matricula: String): List<EmprestimoView>
    + listarAtrasados(data: LocalDate): List<EmprestimoView>
    + reservar(codigoDoItem: String, matricula: String, data: LocalDate): String
    + listarReservas(codigoDoItem: String): List<ReservaView>
    + cancelarReserva(idDaReserva: String): void
}

class RegistroEmprestimo {
    - id: String
    - tombo: String
    - matricula: String
    - dataEmprestimo: LocalDate
    - dataPrevista: LocalDate
    - dataDevolucaoReal: LocalDate
    + RegistroEmprestimo(id: String, tombo: String, matricula: String, dataEmprestimo: LocalDate, dataPrevista: LocalDate)
    + getTombo(): String
    + getMatricula(): String
    + getDataPrevista(): LocalDate
    + getDataDevolucaoReal(): LocalDate
    + setDataDevolucaoReal(dataDevolucaoReal: LocalDate): void
    + toView(): EmprestimoView
}

class RegistroReserva {
    - id: String
    - codigoDoItem: String
    - matricula: String
    - dataReserva: LocalDate
    + RegistroReserva(id: String, codigoDoItem: String, matricula: String, dataReserva: LocalDate)
    + getId(): String
    + getCodigoDoItem(): String
    + toView(): ReservaView
}

EmprestimoService <|.. Emprestimo
AcervoService <|.. AcervoFilme
UsuarioService <|.. Usuario

Emprestimo *-- RegistroEmprestimo : "emprestimos"
Emprestimo *-- RegistroReserva : "reservas"

AcervoFilme *-- "0..*" Item : "gerencia"
AcervoFilme *-- "0..*" Exemplar : "gerencia"
Item "1" *-- "0..*" Exemplar : "contém"

Cineclube --> AcervoService : "usa"
Cineclube --> UsuarioService : "usa"
Cineclube --> EmprestimoService : "usa"

@enduml
