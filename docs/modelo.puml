@startuml
' Modelo de domínio do sistema: Entrega 2.
' Corresponde ao código do pacote filme/.

hide empty members
skinparam classAttributeIconSize 0
skinparam defaultTextAlignment center

enum StatusExemplar {
    DISPONIVEL
    EMPRESTADO
    RESERVADO
    INDISPONIVEL
}

interface Biblioteca {
    + salvar(): void
    + carregar(): void
}
interface AcervoService
interface UsuarioService
interface EmprestimoService
interface RelatorioService

class Cineclube {
    + acervo(): AcervoService
    + usuarios(): UsuarioService
    + emprestimos(): EmprestimoService
    + relatorios(): RelatorioService
    + multas(): MultaService
    + salvar(): void
    + carregar(): void
}

class Item {
    - codigo: String
    - titulo: String
    - autoria: String
    - categoria: String
    - ano: int
    + getExemplares(): List<Exemplar>
    + temExemplarDisponivel(): boolean
    + adicionarExemplar(exemplar: Exemplar): void
}

class Exemplar {
    - tombo: String
    - codigoDoItem: String
    - status: StatusExemplar
    - reservaDona: Reserva
    + podeSerEmprestadoPara(matricula: String): boolean
    + separarPara(reserva: Reserva): void
    + liberar(): void
    + marcarEmprestado(): void
    + marcarIndisponivel(): void
}

class Reserva {
    - id: String
    - codigoDoItem: String
    - matricula: String
    - data: LocalDate
    - exemplarSeparado: Exemplar
    + temExemplar(): boolean
}

class FilaDeReservas {
    - reservas: List<Reserva>
    + entrar(reserva: Reserva): void
    + contem(matricula: String): boolean
    + proximaSemExemplar(): Optional<Reserva>
    + buscarPorId(id: String): Optional<Reserva>
    + remover(reserva: Reserva): void
    + todas(): List<Reserva>
}

class AcervoFilme {
    - itens: List<Item>
    + cadastrarItem(...): void
    + buscarItem(codigo: String): ItemView
    + listarItens(): List<ItemView>
    + buscarPorTitulo(trecho: String): List<ItemView>
    + buscarPorCategoria(categoria: String): List<ItemView>
    + adicionarExemplar(codigoDoItem: String, tombo: String): void
    + listarExemplares(codigoDoItem: String): List<ExemplarView>
    + baixarExemplar(tombo: String): void
    ~ localizarItem(codigo: String): Item
    ~ localizarExemplar(tombo: String): Exemplar
}

class UsuariosEmMemoria {
    - usuariosPorMatricula: Map<String, DadosUsuario>
    + cadastrarUsuario(matricula: String, nome: String): void
    + buscarUsuario(matricula: String): UsuarioView
    + listarUsuarios(): List<UsuarioView>
    + desativarUsuario(matricula: String): void
    + reativarUsuario(matricula: String): void
    + setEmprestimos(emprestimos: Emprestimo): void
}

class DadosUsuario {
    - matricula: String
    - nome: String
    - ativo: boolean
}

class Emprestimo {
    - emprestimos: List<RegistroEmprestimo>
    - filas: Map<String, FilaDeReservas>
    + Emprestimo(acervo: AcervoFilme, usuarios: UsuarioService)
    + emprestar(tombo: String, matricula: String, data: LocalDate): String
    + devolver(tombo: String, data: LocalDate): void
    + listarEmprestimosDoUsuario(matricula: String): List<EmprestimoView>
    + listarAtrasados(data: LocalDate): List<EmprestimoView>
    + reservar(codigoDoItem: String, matricula: String, data: LocalDate): String
    + listarReservas(codigoDoItem: String): List<ReservaView>
    + cancelarReserva(idDaReserva: String): void
    + contarAtivos(matricula: String): int
}

class RegistroEmprestimo {
    - id: String
    - tombo: String
    - matricula: String
    - dataEmprestimo: LocalDate
    - dataPrevista: LocalDate
    - dataDevolucaoReal: LocalDate
    + estaAtivo(): boolean
    + estaAtrasadoEm(data: LocalDate): boolean
    + toView(dataReferencia: LocalDate): EmprestimoView
}

class MultaService {
    {static} + VALOR_POR_DIA: BigDecimal
    + multaDe(e: EmprestimoView, referencia: LocalDate): BigDecimal
    + multaTotalDoUsuario(matricula: String, referencia: LocalDate): BigDecimal
}

class Relatorios

Biblioteca <|.. Cineclube
AcervoService <|.. AcervoFilme
UsuarioService <|.. UsuariosEmMemoria
EmprestimoService <|.. Emprestimo
RelatorioService <|.. Relatorios

Cineclube *-- "1" AcervoFilme
Cineclube *-- "1" UsuariosEmMemoria
Cineclube *-- "1" Emprestimo
Cineclube *-- "1" Relatorios

AcervoFilme *-- "0..*" Item
Item *-- "0..*" Exemplar
Exemplar --> StatusExemplar
Exemplar "0..1" -- "0..1" Reserva : separado para >

UsuariosEmMemoria *-- "0..*" DadosUsuario
UsuariosEmMemoria ..> Emprestimo : contarAtivos

Emprestimo o-- "1" AcervoFilme
Emprestimo o-- "1" UsuarioService
Emprestimo *-- "0..*" RegistroEmprestimo
Emprestimo *-- "0..*" FilaDeReservas : uma por item
FilaDeReservas *-- "0..*" Reserva

MultaService ..> Emprestimo : consulta
Cineclube ..> MultaService : cria
@enduml