@startuml
' Modelo de domínio do sistema: Entrega 1.
'
' Este arquivo é o ponto de partida. Substitua pelo modelo da sua equipe.
' O diagrama precisa corresponder ao código entregue.
'
' Para gerar a imagem: instale o plugin PlantUML no IntelliJ, ou use
'   plantuml docs/modelo.puml
' e versione a imagem gerada ao lado deste arquivo.

skinparam classAttributeIconSize 0
hide empty members

class Item {
 - codigo: String
 - titulo: String
 - autoria: String
 - categoria : String
 - ano : int

 + Item(codigo : String, titulo : String, autoria : String, categoria : String, ano : int)
 + getCodigo(): String
 + getTitulo(): String
 + getAutoria() : String
 + getCategoria() : String
 + getAno() : int
 + getExemplares() : List<Exemplar>
}

class Exemplar {
    - tombo: String
    - codigoDoItem: String
    - item: StatusExemplar
    - status: StatusExemplar

    + Exemplar(tombo: String, item: StatusExemplar, codigoDoItem: String)
    + getcodigoDoItem(): String
    + getTombo(): String
    + getItem(): StatusExemplar
    + setItem(item: StatusExemplar): void
    + getStatus(): StatusExemplar
    + setStatus(status: StatusExemplar): void
}

class Usuario {
 - usuariosPorMatricula : Map<String, UsuarioView>

 + cadastrarUsuario(matricula : String, nome : String) : void
 + buscarUsuario(matricula : String) : UsuarioView
 + listarUsuarios() : List<UsuarioView>
 + desativarUsuario(matricula : String) : void
 + reativarUsuario(matricula : String) : void
}
class Cineclube {
        - acervo : AcervoFilme
        - usuarios : Usuario
        - emprestimos : Emprestimo
        - relatorios : RelatoriosNaoImplementados
        + acervo() : AcervoService
        + usuarios() : UsuarioService
        + emprestimos() : EmprestimoService
        + relatorios() : RelatorioService
        + salvar() : void
        + carregar() : void
}
class Relatorios {
        + itensMaisEmprestados(n : int) : List<ItemView>
        + emprestimosPorCategoria() : Map<String, Long>
        + usuariosComAtraso(data : LocalDate) : List<UsuarioView>
        + taxaDeOcupacaoDoAcervo() : double
        + importarItensEmLote(arquivo : Path) : int
}
class AcervoFilme {
        - itens : List<Item>
        + cadastrarItem(codigo : String, titulo : String, autoria : String, categoria : String, ano : int) : void
        + buscarItem(codigo : String) : ItemView
        + listarItens() : List<ItemView>
        + buscarPorTitulo(trecho : String) : List<ItemView>
        + buscarPorCategoria(categoria : String) : List<ItemView>
        + adicionarExemplar(codigoDoItem : String, tombo : String) : void
        + listarExemplares(codigoDoItem : String) : List<ExemplarView>
        + baixarExemplar(tombo : String) : void
        ~ itens() : List<Item>
        - localizar(codigo : String) : Item
        - paraView(item : Item) : ItemView
        {static} - exigirTextoPreenchido(valor : String, campo : String) : void

}

class Emprestimo {
    + emprestar(tombo: String, matricula: String, data: LocalDate): String
    + devolver(tombo: String, data: LocalDate): void
    + listarEmprestimosDoUsuario(matricula: String): List<EmprestimoView>
    + listarAtrasados(data: LocalDate): List<EmprestimoView>
    + reservar(codigoDoItem: String, matricula: String, data: LocalDate): String
    + listarReservas(codigoDoItem: String): List<ReservaView>
    + cancelarReserva(idDaReserva: String): void
}

AcervoFilme "1" *-- "0..*" Exemplar : gerencia / contém >
Usuario "1" -- "0..*" Emprestimo : realiza >
Exemplar "1" -- "0..1" Emprestimo : é emprestado >
Item "1" --* "0..*" AcervoFilme : gerencia / contém <



@enduml
